{
  "crons": [
    {
      "path": "/api/latido",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/comm-cron",
      "schedule": "30 10 * * *"
    }
  ],
  "functions": {
    "api/anthropic.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/lib/(.*)\\.mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
